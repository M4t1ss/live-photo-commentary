{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Interactive Live Commentary Assistant",
  "version": "0.2.0",
  "identifier": "io.github.m4t1ss.live-photo-commentary",
  "build": {
    "frontendDist": "../frontend",
    "beforeDevCommand": "cargo build -p kokoro-espeak"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Interactive Live Commentary Assistant",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' https://esm.sh https://cdn.jsdelivr.net; style-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost data: blob: https://esm.sh https://cdn.jsdelivr.net; worker-src 'self' blob:; font-src 'self'; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "assetProtocol": {
        "enable": true
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "resources": {
      "resources/llama/*": "./",
      "resources/llama/backends": "backends",
      "../LICENSE": "licenses/LICENSE",
      "../NOTICE.md": "licenses/NOTICE.md",
      "NOTICE.md": "licenses/app/NOTICE.md",
      "LICENSES": "licenses/app/LICENSES",
      "../crates/kokoro-timestamped/LICENSE-MIT": "licenses/kokoro-timestamped/LICENSE-MIT",
      "../crates/kokoro-timestamped/LICENSE-APACHE": "licenses/kokoro-timestamped/LICENSE-APACHE",
      "../crates/kokoro-timestamped/NOTICE.md": "licenses/kokoro-timestamped/NOTICE.md",
      "../crates/kokoro-timestamped/LICENSES": "licenses/kokoro-timestamped/LICENSES",
      "../crates/vlm-describer/LICENSE-MIT": "licenses/vlm-describer/LICENSE-MIT",
      "../crates/vlm-describer/LICENSE-APACHE": "licenses/vlm-describer/LICENSE-APACHE",
      "../crates/kokoro-espeak/LICENSE": "licenses/kokoro-espeak/LICENSE",
      "../crates/kokoro-espeak/NOTICE.md": "licenses/kokoro-espeak/NOTICE.md",
      "../crates/kokoro-espeak/LICENSES": "licenses/kokoro-espeak/LICENSES"
    },
    "windows": {
      "nsis": {
        "installerHooks": "nsis/hooks.nsi"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
