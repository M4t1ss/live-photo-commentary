{
  "build": {
    "beforeBuildCommand": "cargo xtask package-helper src-tauri/binaries --tauri"
  },
  "bundle": {
    "externalBin": ["binaries/kokoro-espeak"],
    "resources": {
      "binaries/espeak-ng-data": "espeak-ng-data",
      "resources/models/model.*": "resources/models/",
      "resources/models/animations/*": "resources/models/animations/"
    }
  }
}
