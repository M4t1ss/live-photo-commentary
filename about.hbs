<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Third-party licences</title>
<style>
  body { font-family: sans-serif; max-width: 60em; margin: 2em auto; padding: 0 1em; }
  pre { white-space: pre-wrap; background: #f4f4f4; padding: 1em; }
  .used-by { font-size: 0.9em; }
</style>
</head>
<body>
<h1>Third-party licences</h1>
<p>The Rust libraries this app is built from, grouped by licence. The app's own
licences and the notices for ported code are in the other files of this folder.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}
  <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
<h2>Licences</h2>
{{#each licenses}}
<div class="license">
  <h3 id="{{id}}">{{name}}</h3>
  <p class="used-by">Used by:</p>
  <ul class="used-by">
  {{#each used_by}}
    <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
  {{/each}}
  </ul>
  <pre>{{text}}</pre>
</div>
{{/each}}
</body>
</html>
